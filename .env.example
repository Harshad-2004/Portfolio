# MongoDB Atlas connection string (database user with read/write on one DB)
# Optional locally: without it, messages are saved to messages.local.jsonl. Required on Vercel unless Resend is set.
MONGODB_URI=
# Resend (https://resend.com). Optional: if empty, messages are still saved to MongoDB.
RESEND_API_KEY=
# Where notifications are delivered (your inbox)
CONTACT_TO_EMAIL=harshadsawant1207@gmail.com
# Sender. Use onboarding@resend.dev until you verify your own domain.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
