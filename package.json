{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio API (api/) and Vite client (client/)",
  "scripts": {
    "dev:api": "node --watch --env-file-if-exists=.env api/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2"
  }
}
